  "glossary": [
    {
      "term": "σ-代数",
      "def": "对补集与可数并封闭、含全集的集合族。",
      "chapterId": "ch09"
    },
    {
      "term": "测度",
      "def": "σ-代数上的可数可加非负函数。",
      "chapterId": "ch09"
    },
    {
      "term": "博雷尔 σ-代数",
      "def": "包含所有开集的最小 σ-代数。",
      "chapterId": "ch09"
    },
    {
      "term": "外测度",
      "def": "用可数覆盖的体积下确界定义、对所有子集有定义的函数。",
      "chapterId": "ch09"
    },
    {
      "term": "可测集",
      "def": "满足卡拉泰奥多里切割条件的集合。",
      "chapterId": "ch09"
    },
    {
      "term": "零测集",
      "def": "测度为 0 的集合。",
      "chapterId": "ch09"
    },
    {
      "term": "几乎处处",
      "def": "除一个零测集之外处处成立。",
      "chapterId": "ch09"
    },
    {
      "term": "勒贝格测度",
      "def": "ℝⁿ 上由外测度限制得到的平移不变测度。",
      "chapterId": "ch09"
    },
    {
      "term": "豪斯多夫维数",
      "def": "使豪斯多夫测度从无穷跳到零的临界维数。",
      "chapterId": "ch09"
    },
    {
      "term": "简单函数",
      "def": "有限个特征函数的线性组合，只取有限多个值。",
      "chapterId": "ch10"
    },
    {
      "term": "可测函数",
      "def": "简单函数列的几乎处处极限。",
      "chapterId": "ch10"
    },
    {
      "term": "博赫纳–勒贝格积分",
      "def": "向量值函数通过 L1 完备化定义的积分。",
      "chapterId": "ch10"
    },
    {
      "term": "单调收敛定理",
      "def": "非负递增函数列可无条件交换极限与积分。",
      "chapterId": "ch10"
    },
    {
      "term": "法图引理",
      "def": "非负函数列给出 ∫liminf ≤ liminf∫ 的不等式。",
      "chapterId": "ch10"
    },
    {
      "term": "控制收敛定理",
      "def": "存在可积控制函数时，逐点收敛可交换极限与积分。",
      "chapterId": "ch10"
    },
    {
      "term": "Lp 空间",
      "def": "p 次方可积函数的等价类空间，配 Lp 范数。",
      "chapterId": "ch10"
    },
    {
      "term": "赫尔德不等式",
      "def": "‖fg‖₁ ≤ ‖f‖ₚ‖g‖_q，1/p+1/q=1。",
      "chapterId": "ch10"
    },
    {
      "term": "闵可夫斯基不等式",
      "def": "Lp 范数满足三角不等式。",
      "chapterId": "ch10"
    },
    {
      "term": "富比尼定理",
      "def": "乘积空间上的积分可化为累次积分。",
      "chapterId": "ch10"
    },
    {
      "term": "卷积",
      "def": "(f∗g)(x)=∫f(x−y)g(y)dy，傅里叶变换下变乘积。",
      "chapterId": "ch10"
    },
    {
      "term": "磨光核",
      "def": "光滑紧支、积分为 1 的非负函数，用于逼近光滑化。",
      "chapterId": "ch10"
    },
    {
      "term": "傅里叶变换",
      "def": "f̂(ξ)=∫f(x)e^(−2πix·ξ)dx，L² 上是酉算子。",
      "chapterId": "ch10"
    },
    {
      "term": "子流形",
      "def": "局部在坐标卡中表现为平面切片的子集。",
      "chapterId": "ch11"
    },
    {
      "term": "浸入",
      "def": "切映射处处单射的光滑映射。",
      "chapterId": "ch11"
    },
    {
      "term": "嵌入",
      "def": "到像为同胚的浸入。",
      "chapterId": "ch11"
    },
    {
      "term": "带边流形",
      "def": "坐标卡取值于半空间，边界为 xₘ=0 的像。",
      "chapterId": "ch11"
    },
    {
      "term": "k-形式",
      "def": "交替 k-线性映射，可楔积、拉回、外微分。",
      "chapterId": "ch11"
    },
    {
      "term": "外微分",
      "def": "d(Σa_I dx^I)=Σda_I∧dx^I，满足 d²=0。",
      "chapterId": "ch11"
    },
    {
      "term": "闭形式",
      "def": "dω=0 的形式。",
      "chapterId": "ch11"
    },
    {
      "term": "恰当形式",
      "def": "等于 dη 的形式。",
      "chapterId": "ch11"
    },
    {
      "term": "黎曼度量",
      "def": "每点切空间上的正定内积场。",
      "chapterId": "ch11"
    },
    {
      "term": "霍奇星",
      "def": "依赖度量与定向、把 k-形式映为 (m−k)-形式的算子。",
      "chapterId": "ch11"
    },
    {
      "term": "体积元",
      "def": "√|det g| dx¹∧…∧dxᵐ，流形上的积分缩放因子。",
      "chapterId": "ch12"
    },
    {
      "term": "斯托克斯定理",
      "def": "∫_∂M ω = ∫_M dω，统一所有积分公式。",
      "chapterId": "ch12"
    }
  ],
