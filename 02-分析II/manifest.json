  "glossary": [
    {
      "term": "阶梯函数",
      "def": "在分割的每个开区间上取常数值的函数。",
      "chapterId": "ch06"
    },
    {
      "term": "跳跃连续",
      "def": "每点处左右单侧极限都存在（可不等于函数值）。",
      "chapterId": "ch06"
    },
    {
      "term": "分段连续",
      "def": "只有有限个跳跃点的跳跃连续函数。",
      "chapterId": "ch06"
    },
    {
      "term": "柯西–黎曼积分",
      "def": "本书对一元函数积分的称呼，由阶梯函数积分延拓得到。",
      "chapterId": "ch06"
    },
    {
      "term": "微积分基本定理",
      "def": "变上限积分求导得被积函数；反之积分等于原函数端点差。",
      "chapterId": "ch06"
    },
    {
      "term": "反常积分",
      "def": "区间无界或被积函数无界时，用极限定义的积分。",
      "chapterId": "ch06"
    },
    {
      "term": "绝对收敛",
      "def": "被积函数绝对值可积；绝对收敛必收敛。",
      "chapterId": "ch06"
    },
    {
      "term": "傅里叶系数",
      "def": "用三角函数内积投影得到的系数 aₖ、bₖ。",
      "chapterId": "ch06"
    },
    {
      "term": "伽马函数",
      "def": "Γ(z)=∫t^(z−1)e^(−t)dt，满足 Γ(n+1)=n!。",
      "chapterId": "ch06"
    },
    {
      "term": "算子范数",
      "def": "线性映射的最大放大倍数，‖A‖=sup‖Ax‖/‖x‖。",
      "chapterId": "ch07"
    },
    {
      "term": "弗雷歇导数",
      "def": "使 f(a+h)=f(a)+Ah+o(‖h‖) 的唯一线性映射 A。",
      "chapterId": "ch07"
    },
    {
      "term": "雅可比矩阵",
      "def": "导数在标准基下的矩阵，元素为偏导数。",
      "chapterId": "ch07"
    },
    {
      "term": "链式法则",
      "def": "复合函数导数等于两个线性映射的复合（矩阵相乘）。",
      "chapterId": "ch07"
    },
    {
      "term": "黑塞矩阵",
      "def": "二阶偏导组成的对称矩阵，表示二阶导数。",
      "chapterId": "ch07"
    },
    {
      "term": "逆映射定理",
      "def": "导数可逆时函数局部可逆，逆映射 C¹ 且导数为原导数的逆。",
      "chapterId": "ch07"
    },
    {
      "term": "隐函数定理",
      "def": "F(a,b)=0 且对 y 的偏导可逆时，可局部解出 y=φ(x)。",
      "chapterId": "ch07"
    },
    {
      "term": "拉格朗日乘子",
      "def": "约束极值中使 ∇f=λ∇g 的比例因子。",
      "chapterId": "ch07"
    },
    {
      "term": "全变差",
      "def": "所有分割折线长度的上确界。",
      "chapterId": "ch08"
    },
    {
      "term": "可求长",
      "def": "全变差有限的曲线。",
      "chapterId": "ch08"
    },
    {
      "term": "普法夫形式",
      "def": "形如 Σaⱼdxⱼ 的 1-形式。",
      "chapterId": "ch08"
    },
    {
      "term": "恰当形式",
      "def": "等于某个函数微分的 1-形式。",
      "chapterId": "ch08"
    },
    {
      "term": "势函数",
      "def": "满足 df=ω 的函数 f。",
      "chapterId": "ch08"
    },
    {
      "term": "全纯函数",
      "def": "复可微的函数，等价于满足柯西–黎曼方程。",
      "chapterId": "ch08"
    },
    {
      "term": "亚纯函数",
      "def": "除孤立极点外全纯的函数。",
      "chapterId": "ch08"
    },
    {
      "term": "留数",
      "def": "洛朗展开中 (z−a)⁻¹ 的系数。",
      "chapterId": "ch08"
    }
  ],
